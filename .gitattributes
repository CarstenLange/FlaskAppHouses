# Auto detect text files and perform LF normalization
* text=auto
*.joblib filter=xet diff=xet merge=xet
*.dockerignore filter=lfs diff=lfs merge=lfs -text
*.gitignore filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.py filter=lfs diff=lfs merge=lfs -text
/LICENSE filter=lfs diff=lfs merge=lfs -text
*.md filter=lfs diff=lfs merge=lfs -text
/dockerfile filter=lfs diff=lfs merge=lfs -text
*.txt filter=lfs diff=lfs merge=lfs -text
*.html filter=lfs diff=lfs merge=lfs -text
*.qmd filter=lfs diff=lfs merge=lfs -text
*.htmlFirst filter=lfs diff=lfs merge=lfs -text
